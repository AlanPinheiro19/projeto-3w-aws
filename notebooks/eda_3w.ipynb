   "source": [
    "---\n",
    "## 9. Verificacao de Vazamento de Dados (Data Leakage)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "if not df_train.empty and 'timestamp' in df_train.columns:\n",

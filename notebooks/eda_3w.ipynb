    "    print('Exemplos:', norm_cols[:10])\n",
    "    print()\n",
    "    print('Split treino/val/teste:')\n",
    "    total_gold = len(df_train) + len(df_val) + len(df_test)\n",
    "    for name, df in [('Treino', df_train), ('Validacao', df_val), ('Teste', df_test)]:\n",
    "        pct = len(df) / total_gold * 100\n",
    "        print(f'  {name}: {len(df):,} registros ({pct:.1f}%)')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "if not df_train.empty and 'class' in df_train.columns:\n",
    "    fig, axes = plt.subplots(1, 3, figsize=(16, 4))\n",
    "    for ax, (name, df) in zip(axes, [('Treino', df_train), ('Validacao', df_val), ('Teste', df_test)]):\n",
    "        if df.empty or 'class' not in df.columns:\n",
    "            continue\n",
    "        counts = df['class'].value_counts().sort_index()\n",
    "        colors = [CLASS_COLORS[int(k) % 10] for k in counts.index]\n",
    "        ax.bar([f'C{int(k)}' for k in counts.index], counts.values, color=colors)\n",
    "        ax.set_title(f'Distribuicao de Classes - {name}')\n",
    "        ax.set_ylabel('Registros')\n",
    "        ax.grid(axis='y', alpha=0.3)\n",
    "    plt.tight_layout()\n",
    "    plt.savefig(REPORT_DIR / 'gold_class_split.png', dpi=150, bbox_inches='tight')\n",
    "    plt.show()"
   ]

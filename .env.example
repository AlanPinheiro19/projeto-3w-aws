# .env.example - Copie para .env e ajuste os valores
# NUNCA commite o arquivo .env no Git

# ---------------------------------------------------------------------------
# GitHub (opcional mas recomendado - evita limite de 60 req/hora sem token)
# Gere em: https://github.com/settings/tokens (scope: public_repo)
# ---------------------------------------------------------------------------
GITHUB_TOKEN=

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_USER=glue_user
POSTGRES_PASSWORD=glue_password
POSTGRES_DB=well_data

# ---------------------------------------------------------------------------
# MinIO (emulador S3 local)
# ---------------------------------------------------------------------------
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
S3_BUCKET=3w-offshore-events

# ---------------------------------------------------------------------------
# AWS
# ---------------------------------------------------------------------------
AWS_REGION=us-east-1

# ---------------------------------------------------------------------------
# pgAdmin
# ---------------------------------------------------------------------------
PGADMIN_EMAIL=admin@3w.local
PGADMIN_PASSWORD=admin

# ---------------------------------------------------------------------------
# Apache Airflow
# ---------------------------------------------------------------------------
# UID do usuario Linux que sera dono dos arquivos de log do Airflow.
# No Linux/Mac: execute `echo -e "AIRFLOW_UID=$(id -u)" >> .env`
# No Windows com Docker Desktop: deixe o valor padrao 50000
AIRFLOW_UID=50000

# Chave Fernet para criptografia de conexoes no Airflow.
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Se vazio, o Airflow usara uma chave padrao (nao recomendado para producao)
AIRFLOW_FERNET_KEY=

# ---------------------------------------------------------------------------
# Projeto
# ---------------------------------------------------------------------------
# PROJECT_DIR e definido automaticamente pelo docker-compose
# Altere apenas se rodar os scripts fora do Docker, em Windows:
# PROJECT_DIR=D:/Alan/Alan/Pos GRADUACAO USP/eEDB-007 - Trabalho de Conclusao/projeto-3w-aws

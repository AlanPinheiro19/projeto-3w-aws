   "source": [
    "# EDA - Dataset 3W Petrobras\n",
    "## Sistema para Deteccao e Classificacao de Eventos Indesejáveis em Pocos de Petroleo Offshore\n",
    "\n",
    "Este notebook realiza a analise exploratoria de dados (EDA) do dataset 3W da Petrobras,\n",
    "verificando qualidade, distribuicao de classes, comportamento dos sensores e\n",
    "padroes temporais nas tres camadas do pipeline: Bronze, Silver e Gold."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import sys\n",
    "import os\n",
    "import warnings\n",
    "from pathlib import Path\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "import matplotlib.ticker as mticker\n",
    "import seaborn as sns\n",
    "\n",
    "warnings.filterwarnings('ignore')\n",
    "pd.set_option('display.max_columns', 50)\n",
    "pd.set_option('display.float_format', '{:.4f}'.format)\n",
    "\n",
    "# Detecta a raiz do projeto automaticamente\n",
    "# - dentro do container jupyter: /home/jovyan/workspace\n",
    "# - localmente no Windows: C:/projeto-3w-aws (ou o caminho real do projeto)\n",
    "PROJECT_ROOT = Path(os.environ.get('PROJECT_DIR', '/home/jovyan/workspace'))\n",
    "sys.path.insert(0, str(PROJECT_ROOT))\n",
    "\n",
    "plt.rcParams.update({\n",
    "    'figure.figsize': (14, 5),\n",
    "    'axes.titlesize': 13,\n",
    "    'axes.labelsize': 11,\n",
    "    'xtick.labelsize': 9,\n",
    "    'ytick.labelsize': 9,\n",
    "    'legend.fontsize': 9,\n",
    "})\n",
    "\n",
    "print('Imports OK | Python', sys.version.split()[0])\n",
    "print('PROJECT_ROOT:', PROJECT_ROOT)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Caminhos\n",
    "BRONZE_DIR  = PROJECT_ROOT / 'data' / 'bronze'\n",
    "SILVER_DIR  = PROJECT_ROOT / 'data' / 'silver'\n",
    "GOLD_DIR    = PROJECT_ROOT / 'data' / 'gold'\n",
    "REPORT_DIR  = PROJECT_ROOT / 'reports'\n",
    "REPORT_DIR.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "SENSOR_COLUMNS = [\n",
    "    'P-PDG', 'P-TPT', 'T-TPT', 'P-MON-CKP',\n",
    "    'T-JUS-CKP', 'P-JUS-CKGL', 'T-JUS-CKGL', 'QGL'\n",
    "]\n",
    "\n",
    "EVENT_LABELS = {\n",
    "    0: 'Normal',\n",
    "    1: 'BSW Abrupt Increase',\n",
    "    2: 'DHSV Spurious Closure',\n",
    "    3: 'Severe Slugging',\n",
    "    4: 'Flow Instability',\n",
    "    5: 'Productivity Loss',\n",
    "    6: 'Restriction in PCK',\n",
    "    7: 'Scaling in PCK',\n",
    "    8: 'Hydrate in Pipeline',\n",
    "    9: 'Undefined',\n",
    "}\n",
    "\n",
    "CLASS_COLORS = plt.cm.tab10.colors\n",
    "\n",
    "print('Configuracao OK')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def load_layer(layer_dir: Path, name: str, fname='*.parquet') -> pd.DataFrame:\n",
    "    files = list(layer_dir.glob(fname))\n",
    "    if not files:\n",
    "        print(f'[AVISO] Nenhum Parquet em {layer_dir}')\n",
    "        return pd.DataFrame()\n",
    "    dfs = [pd.read_parquet(f) for f in files]\n",
    "    df = pd.concat(dfs, ignore_index=True)\n",
    "    print(f'{name}: {len(df):,} linhas x {df.shape[1]} colunas | arquivos: {len(files)}')\n",
    "    return df\n",
    "\n",
    "df_bronze = load_layer(BRONZE_DIR, 'Bronze')\n",
    "df_silver = load_layer(SILVER_DIR, 'Silver')\n",
    "df_train  = load_layer(GOLD_DIR, 'Gold/train', 'train.parquet')\n",
    "df_val    = load_layer(GOLD_DIR, 'Gold/val',   'val.parquet')\n",
    "df_test   = load_layer(GOLD_DIR, 'Gold/test',  'test.parquet')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "---\n",
    "## 1. Visao Geral do Schema"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "if not df_bronze.empty:\n",
    "    print('=== BRONZE - dtypes ===')\n",
    "    print(df_bronze.dtypes)\n",
    "    print()\n",
    "    print('=== BRONZE - head(3) ===')\n",
    "    display(df_bronze.head(3))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "if not df_silver.empty:\n",
    "    print('=== SILVER - describe() ===')\n",
    "    sensor_cols_present = [c for c in SENSOR_COLUMNS if c in df_silver.columns]\n",
    "    display(df_silver[sensor_cols_present].describe().T)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "---\n",
    "## 2. Distribuicao de Classes"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def plot_class_distribution(df: pd.DataFrame, title: str, ax=None):\n",
    "    if 'class' not in df.columns:\n",
    "        return\n",
    "    counts = df['class'].value_counts().sort_index()\n",
    "    labels = [f'{int(k)} - {EVENT_LABELS.get(int(k), \"?")}'[:28] for k in counts.index]\n",
    "    colors = [CLASS_COLORS[int(k) % 10] for k in counts.index]\n",
    "    if ax is None:\n",
    "        fig, ax = plt.subplots(figsize=(12, 4))\n",
    "    bars = ax.barh(labels, counts.values, color=colors)\n",
    "    ax.set_xlabel('Numero de registros')\n",
    "    ax.set_title(title)\n",
    "    ax.xaxis.set_major_formatter(mticker.FuncFormatter(lambda x, _: f'{int(x):,}'))\n",
    "    for bar, val in zip(bars, counts.values):\n",
    "        pct = val / counts.sum() * 100\n",
    "        ax.text(bar.get_width() + counts.max() * 0.01, bar.get_y() + bar.get_height()/2,\n",
    "                f'{pct:.1f}%', va='center', fontsize=8)\n",
    "    return ax\n",
    "\n",
    "if not df_silver.empty:\n",
    "    fig, axes = plt.subplots(1, 2, figsize=(16, 5))\n",
    "    plot_class_distribution(df_bronze, 'Distribuicao de Classes - Bronze', axes[0])\n",
    "    plot_class_distribution(df_silver, 'Distribuicao de Classes - Silver', axes[1])\n",
    "    plt.tight_layout()\n",
    "    plt.savefig(REPORT_DIR / 'class_distribution.png', dpi=150, bbox_inches='tight')\n",
    "    plt.show()\n",
    "    print('Grafico salvo em reports/class_distribution.png')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Imbalance ratio\n",
    "if not df_silver.empty and 'class' in df_silver.columns:\n",
    "    counts = df_silver['class'].value_counts().sort_index()\n",
    "    total = counts.sum()\n",
    "    print(f'Total de registros (Silver): {total:,}')\n",
    "    print(f'Numero de classes presentes: {len(counts)}')\n",
    "    print(f'Imbalance ratio (maior/menor classe): {counts.max()/counts.min():.1f}x')\n",
    "    print()\n",
    "    print('Classe | Nome                        | Count   | Pct')\n",
    "    print('-' * 60)\n",
    "    for cls, cnt in counts.items():\n",
    "        nome = EVENT_LABELS.get(int(cls), '?')\n",
    "        print(f'{int(cls):5d}  | {nome:<28} | {cnt:7,} | {cnt/total*100:.2f}%')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "---\n",
    "## 3. Qualidade dos Dados - Valores Nulos por Sensor"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def plot_null_heatmap(df: pd.DataFrame, title: str):\n",
    "    sensor_cols = [c for c in SENSOR_COLUMNS if c in df.columns]\n",
    "    null_pct = df[sensor_cols].isnull().mean() * 100\n",
    "    fig, ax = plt.subplots(figsize=(12, 3))\n",
    "    sns.heatmap(\n",
    "        null_pct.values.reshape(1, -1),\n",
    "        annot=True, fmt='.1f', cmap='YlOrRd',\n",
    "        xticklabels=sensor_cols, yticklabels=['% nulos'],\n",
    "        ax=ax, vmin=0, vmax=100\n",
    "    )\n",
    "    ax.set_title(title)\n",
    "    plt.tight_layout()\n",
    "    return null_pct\n",
    "\n",
    "if not df_bronze.empty:\n",
    "    print('--- Bronze ---')\n",
    "    null_b = plot_null_heatmap(df_bronze, 'Percentual de Nulos por Sensor - Bronze')\n",
    "    plt.savefig(REPORT_DIR / 'null_heatmap_bronze.png', dpi=150, bbox_inches='tight')\n",
    "    plt.show()\n",
    "\n",
    "if not df_silver.empty:\n",
    "    print('--- Silver ---')\n",
    "    null_s = plot_null_heatmap(df_silver, 'Percentual de Nulos por Sensor - Silver')\n",
    "    plt.savefig(REPORT_DIR / 'null_heatmap_silver.png', dpi=150, bbox_inches='tight')\n",
    "    plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "---\n",
    "## 4. Distribuicao Estatistica dos Sensores por Classe"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "if not df_silver.empty:\n",
    "    sensor_cols_present = [c for c in SENSOR_COLUMNS if c in df_silver.columns]\n",
    "    n_sensors = len(sensor_cols_present)\n",
    "    n_cols = 2\n",
    "    n_rows = (n_sensors + 1) // n_cols\n",
    "    fig, axes = plt.subplots(n_rows, n_cols, figsize=(14, n_rows * 3.5))\n",
    "    axes = axes.flatten()\n",
    "\n",
    "    for i, sensor in enumerate(sensor_cols_present):\n",
    "        ax = axes[i]\n",
    "        classes_present = sorted(df_silver['class'].unique())\n",
    "        data_by_class = []\n",
    "        class_labels = []\n",
    "        for cls in classes_present:\n",
    "            vals = df_silver.loc[df_silver['class'] == cls, sensor].dropna()\n",
    "            if len(vals) > 10:\n",
    "                data_by_class.append(vals.sample(min(1000, len(vals)), random_state=42))\n",
    "                class_labels.append(f'C{int(cls)}')\n",
    "\n",
    "        if data_by_class:\n",
    "            ax.boxplot(data_by_class, labels=class_labels,\n",
    "                       patch_artist=True,\n",
    "                       boxprops=dict(facecolor='lightblue', alpha=0.7),\n",
    "                       medianprops=dict(color='red', linewidth=2),\n",
    "                       flierprops=dict(marker='.', markersize=2, alpha=0.3))\n",
    "        ax.set_title(sensor)\n",
    "        ax.set_xlabel('Classe')\n",
    "        ax.grid(axis='y', alpha=0.3)\n",
    "\n",
    "    for j in range(i + 1, len(axes)):\n",
    "        axes[j].set_visible(False)\n",
    "\n",
    "    plt.suptitle('Distribuicao dos Sensores por Classe de Evento (Silver)', fontsize=14, y=1.01)\n",
    "    plt.tight_layout()\n",
    "    plt.savefig(REPORT_DIR / 'sensor_boxplots_by_class.png', dpi=150, bbox_inches='tight')\n",
    "    plt.show()\n",
    "    print('Grafico salvo em reports/sensor_boxplots_by_class.png')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "---\n",
    "## 5. Matriz de Correlacao dos Sensores"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "if not df_silver.empty:\n",
    "    sensor_cols_present = [c for c in SENSOR_COLUMNS if c in df_silver.columns]\n",
    "    sample = df_silver[sensor_cols_present].sample(min(5000, len(df_silver)), random_state=42)\n",
    "    corr = sample.corr()\n",
    "\n",
    "    fig, ax = plt.subplots(figsize=(9, 7))\n",
    "    sns.heatmap(\n",
    "        corr, annot=True, fmt='.2f', cmap='RdBu_r',\n",
    "        vmin=-1, vmax=1, center=0,\n",
    "        square=True, linewidths=0.5, ax=ax\n",
    "    )\n",
    "    ax.set_title('Matriz de Correlacao dos Sensores (Silver)')\n",
    "    plt.tight_layout()\n",
    "    plt.savefig(REPORT_DIR / 'correlation_matrix.png', dpi=150, bbox_inches='tight')\n",
    "    plt.show()\n",
    "\n",
    "    print('\\nPares com |correlacao| > 0.7:')\n",
    "    for i in range(len(corr.columns)):\n",
    "        for j in range(i+1, len(corr.columns)):\n",
    "            v = corr.iloc[i, j]\n",
    "            if abs(v) > 0.7:\n",
    "                print(f'  {corr.columns[i]} <-> {corr.columns[j]}: {v:.3f}')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "---\n",
    "## 6. Series Temporais por Poco"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "if not df_silver.empty and 'timestamp' in df_silver.columns:\n",
    "    df_silver['timestamp'] = pd.to_datetime(df_silver['timestamp'])\n",
    "    pocos = df_silver['ID_Poco'].unique() if 'ID_Poco' in df_silver.columns else [None]\n",
    "    print(f'Pocos disponiveis: {sorted(pocos)}')\n",
    "\n",
    "    poco_example = sorted(pocos)[0]\n",
    "    df_poco = df_silver[df_silver['ID_Poco'] == poco_example].sort_values('timestamp')\n",
    "\n",
    "    sensors_to_plot = [c for c in ['P-PDG', 'P-TPT', 'T-TPT', 'QGL'] if c in df_poco.columns]\n",
    "    n = len(sensors_to_plot)\n",
    "    fig, axes = plt.subplots(n, 1, figsize=(16, n * 2.5), sharex=True)\n",
    "    if n == 1:\n",
    "        axes = [axes]\n",
    "\n",
    "    for ax, sensor in zip(axes, sensors_to_plot):\n",
    "        for cls in sorted(df_poco['class'].unique()):\n",
    "            mask = df_poco['class'] == cls\n",
    "            ax.scatter(\n",
    "                df_poco.loc[mask, 'timestamp'],\n",
    "                df_poco.loc[mask, sensor],\n",
    "                s=1, alpha=0.5,\n",
    "                color=CLASS_COLORS[int(cls) % 10],\n",
    "                label=f'C{int(cls)}'\n",
    "            )\n",
    "        ax.set_ylabel(sensor)\n",
    "        ax.legend(loc='upper right', markerscale=4, ncol=4)\n",
    "        ax.grid(alpha=0.2)\n",
    "\n",
    "    axes[-1].set_xlabel('Timestamp')\n",
    "    fig.suptitle(f'Serie Temporal - Poco {poco_example}', fontsize=13)\n",
    "    plt.tight_layout()\n",
    "    plt.savefig(REPORT_DIR / f'time_series_poco_{poco_example}.png', dpi=150, bbox_inches='tight')\n",
    "    plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "---\n",
    "## 7. Duracao dos Eventos (por classe)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "if not df_silver.empty and 'timestamp' in df_silver.columns and 'class' in df_silver.columns:\n",
    "    df_silver['timestamp'] = pd.to_datetime(df_silver['timestamp'])\n",
    "    groups = ['ID_Poco', 'class'] if 'ID_Poco' in df_silver.columns else ['class']\n",
    "\n",
    "    duration = df_silver.groupby(groups)['timestamp'].agg(\n",
    "        duracao_horas=lambda x: (x.max() - x.min()).total_seconds() / 3600,\n",
    "        n_leituras='count'\n",
    "    ).reset_index()\n",
    "\n",
    "    fig, axes = plt.subplots(1, 2, figsize=(14, 4))\n",
    "\n",
    "    classes_duration = []\n",
    "    class_labels_d = []\n",
    "    for cls in sorted(duration['class'].unique()):\n",
    "        vals = duration.loc[duration['class'] == cls, 'duracao_horas']\n",
    "        if len(vals) > 0:\n",
    "            classes_duration.append(vals)\n",
    "            class_labels_d.append(f'C{int(cls)}')\n",
    "\n",
    "    if classes_duration:\n",
    "        axes[0].boxplot(classes_duration, labels=class_labels_d, patch_artist=True,\n",
    "                        boxprops=dict(facecolor='lightgreen', alpha=0.7),\n",
    "                        medianprops=dict(color='red', linewidth=2))\n",
    "        axes[0].set_title('Duracao dos Eventos por Classe (horas)')\n",
    "        axes[0].set_ylabel('Horas')\n",
    "        axes[0].grid(axis='y', alpha=0.3)\n",
    "\n",
    "    mean_readings = duration.groupby('class')['n_leituras'].mean()\n",
    "    colors = [CLASS_COLORS[int(k) % 10] for k in mean_readings.index]\n",
    "    axes[1].bar([f'C{int(k)}' for k in mean_readings.index], mean_readings.values, color=colors)\n",
    "    axes[1].set_title('Media de Leituras por Evento e Classe')\n",
    "    axes[1].set_ylabel('Leituras (media)')\n",
    "    axes[1].grid(axis='y', alpha=0.3)\n",
    "\n",
    "    plt.tight_layout()\n",
    "    plt.savefig(REPORT_DIR / 'event_duration.png', dpi=150, bbox_inches='tight')\n",
    "    plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
